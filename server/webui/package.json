{
	"name": "llampart",
	"private": true,
	"version": "2.1.0",
	"description": "Local chat Web UI designed for llama-server.",
	"license": "MIT",
	"author": "Marcin Gluziński",
	"type": "module",
	"engines": {
		"node": "^22.17.0 || ^24.0.0 || >=26.0.0",
		"npm": ">=12.2.0 <13"
	},
	"scripts": {
		"dev": "bash scripts/dev.sh",
		"build": "vite build && ./scripts/post-build.sh",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "npm run validate:settings && npm run validate:themes && npm run validate:docs && npm run validate:imports && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"validate:settings": "node scripts/validate-settings-metadata.mjs",
		"validate:themes": "node scripts/validate-theme-boundaries.mjs",
		"validate:docs": "node scripts/validate-docs.mjs",
		"validate:imports": "node scripts/validate-import-boundaries.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"reset": "rm -rf .svelte-kit node_modules",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "npm run validate:test-discovery && npm run test:unit -- --run",
		"test:unit": "vitest --project=unit",
		"validate:test-discovery": "node scripts/validate-test-discovery.mjs",
		"cleanup": "rm -rf .svelte-kit build node_modules",
		"dev:vite": "node node_modules/vite/bin/vite.js dev --host 0.0.0.0",
		"hooks:install": "bash scripts/install-git-hooks.sh"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.73.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/d3-shape": "3.2.0",
		"@types/hast": "3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.1.0",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"dexie": "^4.4.7",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"sass": "^1.108.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"unified": "^11.0.5",
		"uuid": "^14.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@json-render/core": "0.22.0",
		"@json-render/svelte": "0.22.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@noble/hashes": "2.4.0",
		"d3-shape": "3.2.1",
		"highlight.js": "^11.12.0",
		"katex": "^0.19.1",
		"layerchart": "^2.10.1",
		"lowlight": "^3.3.0",
		"mermaid": "12.3.0",
		"pdfjs-dist": "^6.5.438",
		"rehype-highlight": "^7.0.2",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-rehype": "^11.1.2",
		"svelte-sonner": "^1.2.3",
		"unist-util-visit": "^5.2.0",
		"unist-util-visit-parents": "^6.1.0",
		"zod": "^4.6.7"
	},
	"overrides": {
		"katex": "$katex",
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.5"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.8"
		},
		"runed@^0.35.1": "^0.38.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"fsevents": false
	}
}
